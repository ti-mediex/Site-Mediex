<IfModule mod_rewrite.c>
  # --- /exames: LP desativada em 2026-07-15 (a pedido do cliente) ---
  # Antes isto era uma pagina stub com redirect no cliente (router.replace).
  # Para o crawler ela era HTTP 200, "index, follow" e com o MESMO title da
  # home -> thin content + title duplicado. O 301 aqui resolve server-side e
  # funciona sem JS. O conteudo original segue em src/app/_exames/.
  # PARA REATIVAR: apague a regra abaixo e renomeie _exames -> exames.
  # Ancorado de proposito: NAO pode pegar /exames-lp nem /exames-ocupacionais-*.
  # Fica ANTES da regra de arquivo: o exames.html do build antigo continua no
  # servidor ate uma limpeza, e sem isto ele voltaria a ser servido com 200.
  RewriteRule ^exames/?$ / [R=301,L]

  # --- Artefatos do Next que nao sao pagina ---
  # /404 e /_not-found respondiam 200 (a regra de rota mais abaixo servia
  # 404.html e _not-found.html) = soft 404 indexavel. Agora devolvem 404 de
  # verdade, e o ErrorDocument entrega a /404.html da marca por cima.
  # A condicao REDIRECT_STATUS impede laco: na subrequisicao interna do
  # ErrorDocument a variavel ja esta preenchida e a regra nao reaplica.
  RewriteCond %{ENV:REDIRECT_STATUS} ^$
  RewriteRule ^(404|_not-found)/?$ - [R=404,L]

  # Se ja e arquivo (.html, .css, .js, .svg, imagem, etc.) -> serve direto
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # Para rotas (com ou sem barra final), se existir <rota>.html no root -> serve
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^(.+?)/?$ /$1.html [L]
</IfModule>

ErrorDocument 404 /404.html

# ATENCAO — 404 de asset fica CACHEADO 4h no Cloudflare.
# Um asset pedido durante o deploy (antes de subir) devolve 404; o Cloudflare
# guarda esse 404 (MISS->HIT, max-age=14400) e segue servindo 404 mesmo com o
# arquivo ja no ar — foi o que deixou o site sem CSS em 2026-07-14.
# NAO da para resolver aqui: testado com <If "%{REQUEST_STATUS} == 404"> e com
# Header ... "expr=%{REQUEST_STATUS} == 404" — o Cloudflare sobrescreve o
# Cache-Control da origem (404 de pagina vira 3600, de asset vira 14400).
# Mitigacao real: deploy_next.py sobe /_next ANTES do HTML, fechando a janela.
# Para blindar de vez, criar Cache Rule no painel do Cloudflare (bypass em 404).

Options -Indexes

# === BLOQUEIO DE ARQUIVOS SENSIVEIS ===
# Dotfiles e dirs ocultos (htaccess, htpasswd, env, git, etc.)
# Excecao: .well-known continua acessivel (cPanel + verificacoes)
<FilesMatch "^\.(?!well-known)">
  Require all denied
</FilesMatch>

# Extensoes que nao devem ser servidas (dumps, backups, scripts, fontes)
# 1) Extensao exata no final do nome (foo.sql, foo.zip)
<FilesMatch "\.(bak|backup|swp|old|orig|original|log|sql|sh|inc|py|pyc|ini|conf|yml|yaml|json5|zip|tar|gz|rar|7z|exe|dll|so|jar|war)$">
  Require all denied
</FilesMatch>
# 2) Backups com sufixo timestamp (foo.bak-20260519-080017, foo.sql.old-2)
<FilesMatch "\.(bak|backup|old|orig|original|swp|log)[-.][\w.-]+$">
  Require all denied
</FilesMatch>
# 3) Qualquer arquivo que CONTENHA .bak/.backup no meio do nome
<FilesMatch "\.(bak|backup)[-.0-9a-zA-Z]*$">
  Require all denied
</FilesMatch>

# Bloquear PHPs perigosos remanescentes (RCEs/admin scripts)
# Site Next.js estatico NAO usa PHP - qualquer .php no root e suspeito
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|php8|phps)$">
  Require all denied
</FilesMatch>

# Excecao: unico PHP permitido — endpoint que envia o lead do orcamento por e-mail (SMTP server-side)
<Files "enviar-orcamento.php">
  Require all granted
</Files>

# Bloquear arquivos especificos por nome (whitelist de seguranca)
<FilesMatch "^(wp-config|wp-config-local|wp-config-sample|configuration|config|secrets?|credentials?|backup|dump|export|install|installer|xampp-installer|composer|package-lock|yarn|pnpm|next\.config).*">
  Require all denied
</FilesMatch>

# Bloquear arquivos de mapa-fonte e debug do Next.js
<FilesMatch "\.(map|min\.map|test\.js|spec\.js)$">
  Require all denied
</FilesMatch>

# Bloquear listagem de qualquer dir que contenha "private", "admin", "backup"
RedirectMatch 403 (?i)/(\.private|_private|private|backup|backups|dumps?|admin|wp-admin|wp-content|wp-includes)(/|$)

