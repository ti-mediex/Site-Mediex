  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # === SECURITY HEADERS ===
  # HSTS: forca HTTPS no browser por 1 ano (com preload-ready)
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  # Anti-clickjacking
  Header always set X-Frame-Options "SAMEORIGIN"
  # Bloqueia MIME-sniffing
  Header always set X-Content-Type-Options "nosniff"
  # Politica de referrer
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Restringe APIs sensiveis do navegador
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"
  # CSP ATIVA (promovida de Report-Only em 2026-05-19 apos validacao)
  # Cobre Next.js (inline hydration), Cloudflare Insights, Google Maps, YouTube,
  # Google Ads (AW-*) e GA4 (G-*). GA4 envia os hits para *.google-analytics.com
  # (regionN.google-analytics.com no Brasil) — sem isso no connect-src a tag
  # carrega e o navegador recusa cada envio calado, sem aparecer no curl.
  # Microsoft Clarity: hits para *.clarity.ms e c.bing.com (o Clarity usa o
  # coletor do Bing) — mesmo padrao do GA4, some calado se faltar no connect-src.
  # O script-src precisa do CURINGA, nao so de www.clarity.ms: a URL /tag/<id>
  # e apenas um CARREGADOR, e o Clarity de verdade vem de OUTRO subdominio
  # (scripts.clarity.ms/<versao>/clarity.js). Com so o www a tag baixava e o
  # navegador recusava o segundo script calado — nenhuma sessao era gravada, e
  # um curl no /tag/<id> respondia 200 e nao mostrava nada disso.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com https://www.googletagmanager.com https://googleads.g.doubleclick.net https://elfsightcdn.com https://static.elfsight.com https://*.clarity.ms; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://cloudflareinsights.com https://*.cloudflareinsights.com https://brasilapi.com.br https://pisctwabgnfthixgyhco.supabase.co https://*.elfsight.com https://*.elfsightcdn.com https://api.featurable.com https://www.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com https://www.google.com https://google.com https://www.google.com.br https://google.com.br https://*.doubleclick.net https://www.googleadservices.com https://*.clarity.ms https://c.bing.com; frame-src 'self' https://www.google.com https://www.youtube.com https://www.youtube-nocookie.com https://td.doubleclick.net https://www.googletagmanager.com; media-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"

  # Cross-Origin isolation policies (protege contra Spectre-style + window injection)
  # NOTA (2026-07-14): este COOP faz o window.opener chegar NULO na pagina, e o
  # frame-ancestors/X-Frame-Options impedem iframe de terceiro. O verificador do
  # Google (Tag Assistant, por tras do "Testar" do GA4) precisa de um dos dois
  # caminhos para inspecionar a pagina — por isso ele acusa "tag nao detectada"
  # mesmo com a tag correta e os dados chegando (confirmado: /g/collect -> 204).
  # NAO adianta trocar para "same-origin-allow-popups": testado, corta o opener
  # igual; so "unsafe-none" libera — ou seja, exige desligar a protecao.
  # Mantido "same-origin" de proposito: a coleta do GA4 NAO depende disto, e
  # validar tag se faz pelo relatorio Tempo Real, nao pelo verificador.
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"

  # Remove banner do servidor
  Header unset X-Powered-By
  Header unset Server
  Header always unset X-Powered-By

  # === CACHE ===
  <FilesMatch "^_next/static/">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(xml|txt)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml font/woff2
  AddOutputFilterByType DEFLATE text/xml application/xml
</IfModule>
