# --- Padroes WordPress: tags, categories, autores, paginacao, arquivos por ano ---
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Tags WordPress: /tag/qualquer-coisa/ -> home
  RewriteRule ^tag/.*$ / [R=301,L]

  # Categories WordPress: /category/qualquer-coisa/ -> home
  RewriteRule ^category/.*$ / [R=301,L]

  # Autores WordPress: /author/qualquer/ -> home
  RewriteRule ^author/.*$ / [R=301,L]

  # Paginacao WordPress: /page/2/, /page/3/ -> home
  RewriteRule ^page/[0-9]+/?$ / [R=301,L]

  # Arquivos por ano: /2024/, /2025/ -> home
  RewriteRule ^[0-9]{4}/?$ / [R=301,L]
  RewriteRule ^[0-9]{4}/[0-9]{2}/?$ / [R=301,L]
  RewriteRule ^[0-9]{4}/[0-9]{2}/[0-9]{2}/?$ / [R=301,L]

  # Query strings WordPress (?p=ID): redireciona pra home
  RewriteCond %{QUERY_STRING} ^p=[0-9]+
  RewriteRule ^$ /? [R=301,L]
</IfModule>

