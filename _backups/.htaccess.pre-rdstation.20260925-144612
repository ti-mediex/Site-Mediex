# Mediex - site estatico Next.js (output: export)
# Atualizado 2026-05-19 - headers de seguranca + canonical + HTTPS

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1) Forcar HTTPS (fallback caso Cloudflare nao faca)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2) Canonical: www.mediex.com.br -> mediex.com.br (sem www)
  RewriteCond %{HTTP_HOST} ^www\.mediex\.com\.br$ [NC]
  RewriteRule ^(.*)$ https://mediex.com.br/$1 [L,R=301]

  # 3) Atalhos de divulgacao (vanity URLs) — case-insensitive [NC]
  #    Link curto para anuncios/WhatsApp -> artigo NR-1 riscos psicossociais
  RewriteRule ^psicossocial/?$ /pgr-ppra-recife/blog/nr-1-riscos-psicossociais-2026 [NC,R=301,L]
  RewriteRule ^pgr/psicossocial/?$ /pgr-ppra-recife/blog/nr-1-riscos-psicossociais-2026 [NC,R=301,L]
</IfModule>

